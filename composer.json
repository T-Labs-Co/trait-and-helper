{
    "name": "t-labs-co/trait-and-helper",
    "description": "Collection of reusable traits and helper utilities for Laravel — model protection, bulk operations, enum helpers, array-access, dynamic property configuration, and more.",
    "keywords": [
        "t-labs-co",
        "ty-huynh",
        "laravel",
        "traits",
        "helpers",
        "trait-and-helper",
        "enum-helper",
        "bulk-delete",
        "property-configurable"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ty Huynh",
            "email": "hongty.huynh@gmail.com",
            "homepage": "https://tyhuynh.id.vn",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12|^13",
        "illuminate/database": "^12|^13",
        "illuminate/support": "^12|^13"
    },
    "require-dev": {
        "larastan/larastan": "^3",
        "laravel/pint": "^1",
        "orchestra/testbench": "^10|^11",
        "pestphp/pest": "^4|^5",
        "pestphp/pest-plugin-arch": "^3|^4|^5",
        "pestphp/pest-plugin-laravel": "^4|^5"
    },
    "autoload": {
        "psr-4": {
            "TLabsCo\\TraitAndHelper\\": "src/"
        },
        "files": [
            "src/Support/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TLabsCo\\TraitAndHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --parallel",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TLabsCo\\TraitAndHelper\\Providers\\TraitAndHelperServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
